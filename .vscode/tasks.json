{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "DXFCAD: build and stage FreeCAD 1.1",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/prepare-freecad.ps1"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "DXFCAD: contour domain and integration tests",
            "type": "process",
            "command": "${env:ProgramFiles}/CMake/bin/ctest.exe",
            "args": [
                "--test-dir", "${workspaceFolder}/build/python311",
                "-R", "Contour", "--output-on-failure"
            ],
            "dependsOn": "DXFCAD: build and stage FreeCAD 1.1",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
